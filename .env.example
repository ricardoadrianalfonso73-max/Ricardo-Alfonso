# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Auth Configuration
PORT=3000
AUTH_SECRET="electro-tecno-dev-secret-change-in-production"

# MySQL External Database Configuration (para despliegue con servidor MySQL externo)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="electro_tecno_user"
MYSQL_PASSWORD=""
MYSQL_DATABASE="electro_tecno"
