# Puerto del servidor Express
PORT=4000

# URL del frontend en Vercel (podés separar varias con coma)
CORS_ORIGIN="http://localhost:3000,https://tu-tienda.vercel.app"

# Clave secreta para firmar tokens de sesión
AUTH_SECRET="cambia-esta-clave-en-produccion"

# Configuración para base de datos MySQL externa
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="electro_tecno_user"
MYSQL_PASSWORD=""
MYSQL_DATABASE="electro_tecno"
